# shipyard-cp Environment Configuration
# Copy this file to .env and configure as needed

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3100
NODE_ENV=development

# =============================================================================
# Redis Configuration (Production Persistence)
# =============================================================================
# Redis URL for task/job/result/event storage
REDIS_URL=redis://localhost:6379
# production compose requires REDIS_PASSWORD and injects it into REDIS_URL
# REDIS_PASSWORD=replace-with-a-long-random-value
# Key prefix for namespace isolation
REDIS_KEY_PREFIX=shipyard-cp:

# TTL settings in seconds (optional, defaults shown)
# REDIS_TASK_TTL=15552000       # 180 days
# REDIS_JOB_TTL=2592000         # 30 days
# REDIS_RESULT_TTL=2592000      # 30 days
# REDIS_EVENT_TTL=31536000      # 365 days
# REDIS_GOVERNANCE_TTL=15552000 # decision/question/context/retrospective: 180 days
# REDIS_AUDIT_TTL=31536000      # 365 days
# REDIS_CHECKPOINT_TTL=31536000 # 365 days
# REDIS_IDEMPOTENCY_TTL=2592000 # 30 days
# REDIS_CONNECT_TIMEOUT_MS=5000
# STORE_BACKEND=memory          # production requires redis

# =============================================================================
# External Services
# =============================================================================
# memx-resolver - Document resolver service
MEMX_RESOLVER_URL=http://localhost:8080

# tracker-bridge - Tracker integration service
TRACKER_BRIDGE_URL=http://localhost:8081

# =============================================================================
# API Keys (required for actual usage)
# =============================================================================

# GitHub Personal Access Token (for GitHub Projects, Issues, PRs)
# Required scopes: repo, project
GITHUB_TOKEN=

# OpenAI API Key (for Codex adapter)
OPENAI_API_KEY=

# Anthropic API Key (for Claude Code adapter)
ANTHROPIC_API_KEY=

# Google/Gemini API Key (for Antigravity adapter)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Alibaba Cloud / GLM API Key (for GLM-5 adapter)
# DASHSCOPE_API_KEY or GLM_API_KEY can be used
GLM_API_KEY=
DASHSCOPE_API_KEY=

# =============================================================================
# Worker Backends
# =============================================================================
# Logical worker -> backend selection
# CLAUDE_WORKER_BACKEND: opencode | glm | claude_cli | simulation
# CODEX_WORKER_BACKEND: opencode | simulation
CLAUDE_WORKER_BACKEND=opencode
CODEX_WORKER_BACKEND=opencode

# =============================================================================
# LM Studio / LM Link (OpenAI-compatible API; logical workers stay unchanged)
# =============================================================================
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_TOKEN=
LMSTUDIO_MODEL=
LMSTUDIO_CODEX_MODEL=
LMSTUDIO_CLAUDE_MODEL=
LMSTUDIO_ROUTE_WORKERS=codex,claude_code
LMSTUDIO_ALLOWED_STAGES=plan,dev
LMSTUDIO_MAX_RISK=low
LMSTUDIO_FALLBACK_STAGES=plan
LMSTUDIO_TIMEOUT_MS=300000

# CLI paths
CLAUDE_CLI_PATH=claude
OPENCODE_CLI_PATH=opencode

# =============================================================================
# OpenCode Serve / Session Configuration (Phase 2A)
# =============================================================================
# Execution mode: run (default) or serve
OPENCODE_MODE=run

# Path for opencode serve (defaults to OPENCODE_CLI_PATH)
# OPENCODE_SERVE_PATH=opencode

# Base URL for opencode serve API
# OPENCODE_SERVE_BASE_URL=http://localhost:3001

# Session reuse policy: disabled (default) or same_stage
OPENCODE_SESSION_REUSE=disabled

# Session TTL in milliseconds (default: 1 hour)
# OPENCODE_SESSION_TTL_MS=3600000

# Server startup timeout in milliseconds (default: 30 seconds)
# OPENCODE_SERVER_STARTUP_TIMEOUT_MS=30000

# Reuse lease TTL in milliseconds (default: 5 minutes)
# OPENCODE_REUSE_LEASE_TTL_MS=300000

# =============================================================================
# Authentication (P1 - Production Required)
# =============================================================================
# AUTH_ENABLED=true
# API_KEY=your-api-key-here
# Executable CLI configuration. Secrets are accepted from environment only,
# never from command-line flags.
# SHIPYARD_API_URL=http://localhost:3100
# SHIPYARD_API_KEY=your-api-key-here
# SHIPYARD_ADMIN_API_KEY=your-admin-api-key-here

# production compose also requires CORS_ORIGIN and REDIS_PASSWORD.

# ADMIN_API_KEY=your-admin-api-key-here

# Production is now safe-by-default when API keys are present.
# If you want to force auth on in non-production, set AUTH_ENABLED=true explicitly.

# =============================================================================
# Rate Limiting (Production Recommended)
# =============================================================================
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=100
# RATE_LIMIT_TIME_WINDOW=60000 (in milliseconds, default: 1 minute)

# =============================================================================
# CORS Configuration (Production Required)
# =============================================================================
# In production, you MUST set CORS_ORIGIN to your allowed frontend domains.
# Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Development mode allows all origins by default.
# CORS_ORIGIN=
# CORS_ENABLED=true

# =============================================================================
# Optional: route claude_code through GLM or a local OpenAI-compatible endpoint
# =============================================================================
# CLAUDE_WORKER_BACKEND=glm
# Alibaba_CodingPlan_API_ENDPOINT=https://coding-intl.dashscope.aliyuncs.com/v1
# Alibaba_CodingPlan_MODEL=glm-5
#
# Local llama-server example:
# CLAUDE_WORKER_BACKEND=glm
# Alibaba_CodingPlan_API_ENDPOINT=http://127.0.0.1:8082/v1
# Alibaba_CodingPlan_MODEL=supergemma4-26b-uncensored-fast-v2-q4_k_m
# GLM_API_KEY=local-not-required

# =============================================================================
# Optional Configuration
# =============================================================================

# Google Cloud Project (for Antigravity adapter)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable debug logging for specific domains
DEBUG_SHIPYARD=

# Monitoring
# SENTRY_DSN=https://xxx@sentry.io/xxx
