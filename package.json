{
  "name": "shipyard-cp",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.3",
      "ws": "8.21.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "description": "AI worker orchestration control plane scaffold",
  "bin": {
    "shipyard": "./dist/cli.js"
  },
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "pnpm run build:backend && pnpm run build:web",
    "build:backend": "pnpm run build:packages && tsc -p tsconfig.json",
    "build:web": "pnpm --dir web run build",
    "build:packages": "pnpm --filter shared-redis-utils run build && pnpm --filter memx-resolver-js run build && pnpm --filter tracker-bridge-js run build && pnpm --filter agent-taskstate-js run build",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src packages",
    "lint:web": "pnpm --dir web run lint",
    "lint:all": "pnpm run lint && pnpm run lint:web",
    "lint:fix": "eslint src packages --fix",
    "test": "pnpm run test:backend",
    "test:backend": "vitest run",
    "test:web": "pnpm --dir web run test",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:modules": "tsx scripts/check-module-size.ts",
    "check:docs": "tsx scripts/check-doc-freshness.ts",
    "check:all": "pnpm run build && pnpm run check && pnpm run lint:all && pnpm run test:backend && pnpm run test:web && pnpm run check:modules && pnpm run check:docs"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "shared-redis-utils": "workspace:*",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "agent-taskstate-js": "workspace:*",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.0",
    "memx-resolver-js": "workspace:*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "tracker-bridge-js": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^24.0.0",
    "@types/pino": "^7.0.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.0.0",
    "ws": "^8.21.0"
  }
}
